{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "Username": "%RABBITMQ_USER%",
    "Password": "%RABBITMQ_PASS%",
    "ExchangeName": "events.exchange",
    "Consumers": {
      "VenueCreatedIntegrationEvent": {
        "ExchangeName": "events.exchange",
        "QueueName": "venue-created-queue",
        "DeadLetterExchange": "events.exchange.dlx",
        "DeadLetterQueue": "venue-created-queue.dlq",
        "PrefetchCount": 10
      }
    }
  }
}
